# Copy to .env and fill in real values. Never commit the real .env file.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=posnackschool.org
SESSION_SECRET=

# Same GCP project already confirmed working for Vertex AI in the PAL platform build
GCP_PROJECT_ID=project-895964e2-a6ae-420f-813
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite

# Path INSIDE the backend container — mount the real key file at ./secrets/service-account.json
SERVICE_ACCOUNT_KEY_PATH=/run/secrets/service-account.json

# DEV MODE ONLY — set this to skip the Google Groups lookup entirely and
# treat every signed-in user as this role. Lets you test login + the
# gateway before a Workspace admin has set up the real groups. UNSET
# before anything resembling real use — this bypasses all real access
# control. Leave blank/commented out normally.
# DEV_FAKE_ROLE=Teacher
# DEV_FAKE_GRADE_BAND=High School
